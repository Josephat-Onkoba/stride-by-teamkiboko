# ==========================================
# Stride v3 Environment Variables
# ==========================================
# Copy this file to .env and fill in your own credentials:
# cp .env.example .env

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
# 1. Create a free project at https://supabase.com
# 2. Run the SQL schema from: drizzle/migrations/0000_create_stride_profiles_and_roles.sql
# 3. Find your Project URL and Publishable Anon Key under Project Settings -> API.

SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Client-side Vite environment variables (mirrors the above for browser access)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# ------------------------------------------
# Backend ML API URL (Optional)
# ------------------------------------------
# Default proxy in vite.config.ts points to http://127.0.0.1:8000
VITE_API_BASE_URL="http://127.0.0.1:8000"
